# Runtime network security
# Keep HOST on loopback for local-only use. Set 0.0.0.0 only behind HTTPS/reverse proxy.
HOST=127.0.0.1
PORT=6767
RUNTIME_AUTH_TOKEN=replace-with-a-long-random-token-before-public-deployment
CORS_ALLOWED_ORIGINS=http://127.0.0.1:6767,http://localhost:6767
AGENT_PORT=8888
AGENT_WS_PORT=9999
MAX_JSON_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=524288000
# Keep disabled in production; enables generated chat/game events for demos only.
ENABLE_SIMULATION=false
RUNTIME_DB_PATH=runtime-data/runtime.sqlite

# Gemini uses a Google account authenticated locally with `gcloud auth application-default login`.
# Do not put credentials in the dashboard or this file. The runtime fetches short-lived local ADC tokens.
GCLOUD_BIN=gcloud
GOOGLE_CLOUD_PROJECT=
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro
OBS_WEBSOCKET_PASSWORD=

# Unified live chat OAuth. These IDs belong to the AI IDOL app build; end users
# only sign in and grant access. Google uses Desktop OAuth + PKCE. Facebook uses
# the public App ID flow and never exposes an App Secret in the desktop app.
GOOGLE_OAUTH_CLIENT_ID=592506943214-3i76k7r31250u3gphtott19g15pe54tg.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:6767/api/platform-chat/youtube/oauth/callback
FACEBOOK_APP_ID=
FACEBOOK_OAUTH_REDIRECT_URI=http://127.0.0.1:6767/api/platform-chat/facebook/oauth/callback
META_GRAPH_VERSION=v24.0

# Local AI Director (Ollama/Qwen).
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_BIN=ollama

# LiveTalking worker
LIVETALKING_TRAIN_WORKERS=1
AVATAR_TRAIN_RESOURCE_FRACTION=0.20
LIVETALKING_BATCH_SIZE=4
LIVETALKING_FPS=15
LIVETALKING_OUTPUT_FPS=30
LIVETALKING_VIDEO_QUALITY=fhd
LIVETALKING_PREPROCESS_QUALITY=hd
LIVETALKING_MAX_WIDTH=1920
LIVETALKING_MAX_HEIGHT=1080
LIVETALKING_PREBUFFER_MS=480
LIVETALKING_ENDPOINT=http://127.0.0.1:2222
LIVETALKING_PORT=2222
LIVETALKING_AUTH_TOKEN=replace-with-a-separate-long-worker-token
LIVETALKING_TTS_VOICE=vi-VN-HoaiMyNeural
LIVETALKING_HOST=127.0.0.1
LIVETALKING_ALLOWED_HOSTS=127.0.0.1,localhost,::1
LIVETALKING_CORS_ALLOWED_ORIGINS=http://127.0.0.1:6767,http://localhost:6767
LIVETALKING_MAX_UPLOAD_BYTES=524288000
LIVETALKING_MAX_AUDIO_BYTES=26214400
LIVETALKING_MAX_SESSION=1
LIVETALKING_STUN_URL=stun:stun.l.google.com:19302
LIVETALKING_TURN_URL=
LIVETALKING_TURN_USERNAME=
LIVETALKING_TURN_PASSWORD=
# Optional comma-separated absolute paths. run_worker.sh adds local-projects by default.
LIVETALKING_ALLOWED_MEDIA_ROOTS=
LIVETALKING_ALLOWED_AVATAR_ROOTS=
OMNIVOICE_ENDPOINT=http://127.0.0.1:7861
OMNIVOICE_ALLOWED_HOSTS=127.0.0.1,localhost,::1
OMNIVOICE_MODEL=omnivoice
OMNIVOICE_VI_FEMALE_VOICE=nova

# Local Vietnamese Qwen TTS 0.6B service (default voice provider)
QWEN_TTS_ENDPOINT=http://127.0.0.1:3333
QWEN_TTS_PORT=3333
QWEN_TTS_MODEL_PATH=runtime-data/qwen-tts/gwen-tts-0.6B-8bit
