# Runtime network security
# Keep HOST on loopback for local-only use. Set 0.0.0.0 only behind HTTPS/reverse proxy.
HOST=127.0.0.1
PORT=8765
RUNTIME_AUTH_TOKEN=replace-with-a-long-random-token-before-public-deployment
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
MAX_JSON_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=524288000
# Keep disabled in production; enables generated chat/game events for demos only.
ENABLE_SIMULATION=false
RUNTIME_DB_PATH=runtime-data/runtime.sqlite

# Provider credentials — never place these values in frontend files.
TTM_API_KEY=
TTM_API_BASE_URL=https://ttmapi.site/v1
OPENAI_API_KEY=
OBS_WEBSOCKET_PASSWORD=

# Local AI Director (Ollama/Qwen).
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_BIN=ollama

# LiveTalking worker
LIVETALKING_TRAIN_WORKERS=1
AVATAR_TRAIN_RESOURCE_FRACTION=0.20
LIVETALKING_BATCH_SIZE=8
LIVETALKING_FPS=12.5
LIVETALKING_OUTPUT_FPS=25
LIVETALKING_ENDPOINT=http://127.0.0.1:8011
LIVETALKING_AUTH_TOKEN=replace-with-a-separate-long-worker-token
LIVETALKING_TTS_VOICE=vi-VN-HoaiMyNeural
LIVETALKING_HOST=127.0.0.1
LIVETALKING_ALLOWED_HOSTS=127.0.0.1,localhost,::1
LIVETALKING_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
LIVETALKING_MAX_UPLOAD_BYTES=524288000
LIVETALKING_MAX_AUDIO_BYTES=26214400
LIVETALKING_MAX_SESSION=1
LIVETALKING_STUN_URL=stun:stun.l.google.com:19302
LIVETALKING_TURN_URL=
LIVETALKING_TURN_USERNAME=
LIVETALKING_TURN_PASSWORD=
# Optional comma-separated absolute paths. run_worker.sh adds local-projects by default.
LIVETALKING_ALLOWED_MEDIA_ROOTS=
LIVETALKING_ALLOWED_AVATAR_ROOTS=
OMNIVOICE_ENDPOINT=http://127.0.0.1:7861
OMNIVOICE_ALLOWED_HOSTS=127.0.0.1,localhost,::1
OMNIVOICE_MODEL=omnivoice
OMNIVOICE_VI_FEMALE_VOICE=nova

# Local Vietnamese Qwen TTS 0.6B service (default voice provider)
QWEN_TTS_ENDPOINT=http://127.0.0.1:8002
QWEN_TTS_MODEL_PATH=runtime-data/qwen-tts/gwen-tts-0.6B-8bit
