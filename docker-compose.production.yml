name: ai-livestream

services:
  runtime:
    build:
      context: .
      dockerfile: Dockerfile.runtime
    restart: unless-stopped
    environment:
      HOST: 0.0.0.0
      PORT: 8765
      NODE_ENV: production
      ENABLE_SIMULATION: "false"
      CORS_ALLOWED_ORIGINS: https://${PUBLIC_HOST}
      LIVETALKING_ENDPOINT: http://livetalking:8011
      OLLAMA_ENDPOINT: ${OLLAMA_ENDPOINT:-http://host.docker.internal:11434}
      OLLAMA_MODEL: ${OLLAMA_MODEL:-qwen3.5:35b-64k}
      RUNTIME_DB_PATH: /app/runtime-data/runtime.sqlite
      RUNTIME_AUTH_TOKEN: ${RUNTIME_AUTH_TOKEN}
      LIVETALKING_AUTH_TOKEN: ${LIVETALKING_AUTH_TOKEN}
      ELEVENLABS_API_KEY: ${ELEVENLABS_API_KEY:-}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      OBS_WEBSOCKET_PASSWORD: ${OBS_WEBSOCKET_PASSWORD:-}
    expose:
      - "8765"
    volumes:
      - ./runtime-data:/app/runtime-data
      - ./local-projects:/app/local-projects
    extra_hosts:
      - host.docker.internal:host-gateway
    depends_on:
      livetalking:
        condition: service_healthy

  livetalking:
    build:
      context: .
      dockerfile: Dockerfile.worker
    restart: unless-stopped
    gpus: all
    shm_size: 4gb
    environment:
      LIVETALKING_HOST: 0.0.0.0
      LIVETALKING_PORT: 8011
      LIVETALKING_AUTH_TOKEN: ${LIVETALKING_AUTH_TOKEN}
      LIVETALKING_MODEL: ${LIVETALKING_MODEL:-musetalk}
      LIVETALKING_AVATAR_ID: ${LIVETALKING_AVATAR_ID:-musetalk_avatar1}
      LIVETALKING_BATCH_SIZE: ${LIVETALKING_BATCH_SIZE:-12}
      LIVETALKING_MAX_SESSION: ${LIVETALKING_MAX_SESSION:-1}
      LIVETALKING_MAX_AUDIO_BYTES: ${LIVETALKING_MAX_AUDIO_BYTES:-26214400}
      LIVETALKING_TTS_VOICE: ${LIVETALKING_TTS_VOICE:-vi-VN-HoaiMyNeural}
      LIVETALKING_CORS_ALLOWED_ORIGINS: https://${PUBLIC_HOST}
      LIVETALKING_ALLOWED_MEDIA_ROOTS: /app/data/tmp,/app/data/avatars,/projects
      LIVETALKING_ALLOWED_AVATAR_ROOTS: /app/data/avatars,/projects
      LIVETALKING_STUN_URL: stun:stun.l.google.com:19302
      LIVETALKING_TURN_URL: turn:${PUBLIC_HOST}:3478?transport=udp
      LIVETALKING_TURN_USERNAME: ${TURN_USERNAME}
      LIVETALKING_TURN_PASSWORD: ${TURN_PASSWORD}
    expose:
      - "8011"
    volumes:
      - ./services/talking-head/livetalking/models:/app/models:ro
      - ./services/talking-head/livetalking/data/avatars:/app/data/avatars
      - ./local-projects:/projects
    depends_on:
      coturn:
        condition: service_started

  coturn:
    image: coturn/coturn:4.6.3
    restart: unless-stopped
    command:
      - --no-cli
      - --fingerprint
      - --lt-cred-mech
      - --user=${TURN_USERNAME}:${TURN_PASSWORD}
      - --realm=${PUBLIC_HOST}
      - --external-ip=${TURN_EXTERNAL_IP}
      - --min-port=49160
      - --max-port=49200
      - --log-file=stdout
    ports:
      - "3478:3478/tcp"
      - "3478:3478/udp"
      - "49160-49200:49160-49200/udp"

  caddy:
    image: caddy:2.9-alpine
    restart: unless-stopped
    environment:
      PUBLIC_HOST: ${PUBLIC_HOST}
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./deploy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      runtime:
        condition: service_healthy

  ollama:
    image: ollama/ollama:latest
    profiles: ["local-ai"]
    restart: unless-stopped
    gpus: all
    volumes:
      - ollama_data:/root/.ollama
    expose:
      - "11434"

volumes:
  caddy_data:
  caddy_config:
  ollama_data:
